MCP_HTTP_TOKEN=replace-with-a-long-random-token
# Directory mounted read-write as /vault: a local folder, a network mount, or
# a synchronised copy of the vault.
VAULT_DIR=/srv/ClaudeVault
# Owner of the vault directory (`id -u`:`id -g`).
VAULT_UID_GID=1000:1000
# 127.0.0.1 keeps the port on this machine; use the LAN address to reach it from another one.
MCP_HTTP_BIND=127.0.0.1
