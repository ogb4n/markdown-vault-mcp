MCP_HTTP_TOKEN=replace-with-a-long-random-token
ONEDRIVE_CLIENT_ID=your-microsoft-entra-application-client-id
# Use consumers for a personal Microsoft account; use your tenant ID for work or school.
ONEDRIVE_TENANT_ID=consumers
# Values are OneDrive-relative directories. Keep the scope as narrow as possible.
MARKDOWN_REPOSITORIES={"claude-vault":"ClaudeVault"}
MARKDOWN_DEFAULT_REPOSITORY=claude-vault
